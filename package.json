{
  "name": "@winston-ai/mcp-server",
  "version": "1.0.0",
  "description": "Official Winston AI MCP server for strategic planning, execution outlines, and decision briefs.",
  "type": "module",
  "bin": {
    "winston-ai-mcp-server": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test && npm audit --audit-level=high"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonesiiiedwin0-ops/airtop-ai.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "winston-ai",
    "ai-planning"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jonesiiiedwin0-ops/airtop-ai/issues"
  },
  "homepage": "https://github.com/jonesiiiedwin0-ops/airtop-ai#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
