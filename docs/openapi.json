{
  "openapi": "3.1.0",
  "info": {
    "title": "Winston AI API",
    "version": "0.1.0",
    "description": "Official Winston AI server scaffold API."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000",
      "description": "Local development"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Server is healthy"
          }
        }
      }
    },
    "/v1/status": {
      "get": {
        "summary": "Service status",
        "responses": {
          "200": {
            "description": "Winston AI metadata and capabilities"
          }
        }
      }
    },
    "/v1/outline": {
      "get": {
        "summary": "Year-one technical outline",
        "responses": {
          "200": {
            "description": "Technical buildout horizons and exit criteria"
          }
        }
      }
    },
    "/v1/mcp-context": {
      "get": {
        "summary": "MCP context registry",
        "responses": {
          "200": {
            "description": "External MCP systems used for service context"
          }
        }
      }
    },
    "/v1/chat": {
      "post": {
        "summary": "Assistant response scaffold",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "message"
                ],
                "properties": {
                  "message": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Deterministic assistant response"
          },
          "400": {
            "description": "Invalid request payload"
          },
          "415": {
            "description": "Unsupported media type"
          }
        }
      }
    }
  }
}
